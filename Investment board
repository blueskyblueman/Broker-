<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Coinbase Pro</title>
<style>body{font-family:sans-serif;margin:0;background:#f7f9fa;color:#242628;}.app{max-width:500px;margin:auto;padding:15px;}h1{text-align:center;font-size:32px}.card{background:white;padding:35px;border-radius:24px;box-shadow:0 8px 32px rgba(0,0,0,.06);text-align:left;margin-bottom:30px}label{color:#aeb3b9;font-weight:bold;display:block;font-size:16px;margin-top:-5px}#ethVal{font-size:48px;font-weight:bold;color:black;line-height:.9}.usd-val{display:block;margin-top:-2px;font-size:18px;color:#eaecef}</style></head>
<body class="app"><header style="text-align:center;margin-bottom:30px;"><h1><span style="color:#aeb3b9; margin-right:-8px;">+</span>Coinbase<span style="color:#f79400">Pro</span></h1><div id="livePriceDisplay" style="font-weight:bold;color:black;">$3,420.50 (ETH)</div></header><div class="card"><label>Total Wallet Balance</label><span id="ethVal">1.85 ETH</span><span class="usd-val">$6,336.92</span><small style="display:block;margin-top:15px;font-size:12px;color:#aeb3b9;opacity:.7;">● Live Market & Verified Secure</small></div><div class="controls" style="padding:0 15px;display:flex;gap:15px;"><button onclick="deposit()" style="flex:1;height:60px;background:white;border:none;border-radius:24px;color:black;font-weight:bold;font-size:18px;box-shadow:0 4px 12px rgba(38,57,69,.15);">DEPOSIT ETH</button><button onclick="withdraw()" style="flex:1;height:60px;background:#23d16b;color:white;border:none;border-radius:24px;font-weight:bold;font-size:18px;box-shadow:0 4px 12px rgba(35,209,107,.4);">WITHDRAW PROFIT</button></div><div id="console" class="log-container" style="background:#f7f9fa;color:#6b7280;height:35%;overflow-y:auto;border-radius:24px;padding-bottom:15px;"><small style="padding:15px;display:block;">System Ready. Connected to Ethereum Mainnet...</small></div><script>const price=3420.50;let ethBal=1.85;function log(msg){ const root=document.getElementById('console'); const div=document.createElement('div'); div.style.padding='10px 15px';borderBottom:'1px solid #eaecef';font-size:"13px";div.innerHTML='<span style=\'opacity:.7\'>Now</span> '+msg;root.insertBefore(div,root.firstChild);}function deposit(){log("Connecting to Ethereum Node...");setTimeout(()=>{ let amtUSD=prompt(`Enter deposit amount ($):`, "945.32")||"945";let ethAmt=parseFloat(amtUSD)/price;ethBal+=ethAmt;document.getElementById('ethVal').innerText=ethBal.toFixed(6)+" ETH"; log("✅ Confirmed! Added "+ethAmt.toFixed(6)+" ETH");},1000);}function withdraw(){if(ethBal<0.01)return alert("Min withdraw: 0.01 ETH"); setTimeout(()=>{ let amtETH=prompt(`Enter amount to send (ETH):`, "0.5")||"0.5";let feeUSD=Math.random()*1.5;ethBal-=parseFloat(amtETH)+(feeUSD/price);document.getElementById('ethVal').innerText=ethBal.toFixed(8)+" ETH";log("✅ Sent! Hash: 0x"+Math.random().toString(16).substr(2,34));},2000+Math.random()*3000);}setInterval(()=>{let changePct=(Math.random()-0.5)*0.8; price+= (price * (changePct/100));if(price<320)price=320;},2500);}</script><div style="padding:15px;text-align:center;font-size:12px;color:#aeb3b9;">NexusTrade™ Pro v1.2 • Secure Connection</div></body></html>
